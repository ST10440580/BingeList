<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/binge_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Round App Logo -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivRegisterLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/app_logo"
            app:cornerSize="50%"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textColor="@color/binge_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="Join BingeList to track your favorite movies"
            android:textColor="@color/binge_text_secondary"
            android:textSize="14sp" />

        <!-- First Name Field -->
        <EditText
            android:id="@+id/etRegisterFirstName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/search_bar_background"
            android:hint="First name"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="16dp"
            android:textColor="@color/binge_text_primary"
            android:textColorHint="@color/binge_text_secondary"
            android:textSize="15sp" />

        <!-- Surname Field -->
        <EditText
            android:id="@+id/etRegisterSurname"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/search_bar_background"
            android:hint="Surname"
            android:inputType="textPersonName|textCapWords"
            android:paddingHorizontal="16dp"
            android:textColor="@color/binge_text_primary"
            android:textColorHint="@color/binge_text_secondary"
            android:textSize="15sp" />

        <!-- Phone Number Field -->
        <EditText
            android:id="@+id/etRegisterPhone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/search_bar_background"
            android:hint="Phone number"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:textColor="@color/binge_text_primary"
            android:textColorHint="@color/binge_text_secondary"
            android:textSize="15sp" />

        <!-- Email Field -->
        <EditText
            android:id="@+id/etRegisterEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/search_bar_background"
            android:hint="Email address"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="16dp"
            android:textColor="@color/binge_text_primary"
            android:textColorHint="@color/binge_text_secondary"
            android:textSize="15sp" />

        <!-- Password Field -->
        <EditText
            android:id="@+id/etRegisterPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/search_bar_background"
            android:hint="Password (min 6 characters)"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:textColor="@color/binge_text_primary"
            android:textColorHint="@color/binge_text_secondary"
            android:textSize="15sp" />

        <!-- Sign Up Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:text="Sign Up"
            android:textAllCaps="false"
            android:textColor="@color/binge_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/binge_red"
            app:cornerRadius="27dp" />

        <ProgressBar
            android:id="@+id/registerProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/binge_red"
            android:visibility="gone" />

        <!-- Switch to Log in -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="@color/binge_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvGoToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log In"
                android:textColor="@color/binge_red"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>