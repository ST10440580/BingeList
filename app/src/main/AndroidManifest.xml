<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet access for TMDB, OMDB, and Firebase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".BingeListApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Binge List"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BingeList.NoActionBar">

        <!-- Welcome / Splash Screen (App Entry Point) -->
        <activity
            android:name=".ui.account.WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Screen -->
        <activity
            android:name=".ui.account.LoginActivity"
            android:exported="false" />

        <!-- Registration Screen -->
        <activity
            android:name=".ui.account.RegisterActivity"
            android:exported="false" />

        <!-- Profile Screen -->
        <activity
            android:name=".ui.account.ProfileActivity"
            android:exported="false" />

        <!-- Discover (Main browse screen) -->
        <activity
            android:name=".ui.discover.DiscoverActivity"
            android:exported="false" />

        <!-- Movie Details Screen -->
        <activity
            android:name=".ui.details.MovieDetailsActivity"
            android:exported="false" />

        <!-- Watchlist Screen -->
        <activity
            android:name=".ui.watchlist.WatchlistActivity"
            android:exported="false" />

        <!-- Favorites Screen -->
        <activity
            android:name=".ui.favorites.FavoritesActivity"
            android:exported="false" />

        <!-- Settings Screen -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />

    </application>

</manifest>